{
  "description": "harness-core: 묶음 규칙과 문서 수준별 문서 규칙 주입(하루 한 번 문서 전체 검사 알림), 잘릴 만큼 긴 Bash 명령 거부",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/inject.py\" rules.md \"docs-{docs}.md\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_guard.py\""
          }
        ]
      }
    ]
  }
}
